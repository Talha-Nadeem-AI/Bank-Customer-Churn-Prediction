# Raw data contains personal fields (Surname, CustomerId) - do not commit it.
# Each member downloads it from Kaggle (see README).
data/raw/*.csv

# Generated by `python main.py`. The final model is committed on purpose so the deployed
# app shows the same results as the report without retraining; other model files are not.
models/*.joblib
!models/final_model.joblib
outputs/run.log

